# =============================================================================
# Variáveis de ambiente do back-end. Copie para ".env" e preencha.
# NUNCA faça commit do arquivo .env.
# =============================================================================

# Ambiente: development | production | test
NODE_ENV=development
PORT=3333

# --- Banco (Neon PostgreSQL) ---
# DATABASE_URL: conexão com pooler (host com "-pooler"), usada pela aplicação.
# DIRECT_URL: conexão direta (sem "-pooler"), usada pelas migrations.
DATABASE_URL="postgresql://neondb_owner:npg_csVpx3AQ2eGl@ep-jolly-hat-b6hvlxg1-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_csVpx3AQ2eGl@ep-jolly-hat-b6hvlxg1.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Autenticação ---
# Gere um segredo longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=d4e5c9a61bda0705b0cc9e060c227b444fd5491e481684f80c7e503263140758535745279b2f2c113fc357de83a1b33d
JWT_EXPIRES_IN=1d

# --- CORS ---
# URL do front-end. Para mais de uma origem, separe por vírgula.
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (upload de imagens) ---
# Painel do Cloudinary → Dashboard → "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Gemini (IA) ---
# Gere a chave em https://aistudio.google.com/apikey
# Modelo com suporte a imagem e JSON estruturado, ex.: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Login com Google ---
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Deve ser o MESMO valor de VITE_GOOGLE_CLIENT_ID no front-end.
GOOGLE_CLIENT_ID=
