# =============================================================================
# Variáveis do front-end (Vite). Copie para ".env" e preencha.
# Só variáveis com prefixo VITE_ ficam disponíveis no navegador — nunca coloque segredos aqui.
# =============================================================================

# URL da API (com /api no final)
VITE_API_URL=http://localhost:3333/api

# Mesmo valor de GOOGLE_CLIENT_ID do back-end. Se vazio, o botão "Entrar com Google" fica oculto.
VITE_GOOGLE_CLIENT_ID=
